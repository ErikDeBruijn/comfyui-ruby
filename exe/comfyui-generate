#!/usr/bin/env ruby
require "comfyui"

prompt = ARGV.join(" ")
if prompt.empty?
  warn "Usage: comfyui-generate <prompt>"
  warn "Environment: WIDTH, HEIGHT, STEPS, COMFYUI_URL, OUTPUT_DIR"
  exit 1
end

width = ENV.fetch("WIDTH", 512).to_i
height = ENV.fetch("HEIGHT", 512).to_i
steps = ENV.fetch("STEPS", 20).to_i

warn "Generating image: #{prompt} (#{width}x#{height}, #{steps} steps)..."

result = Comfyui.generate_image(prompt, width: width, height: height, steps: steps)

output_dir = ENV.fetch("OUTPUT_DIR", File.join(Dir.pwd, "tmp/comfyui_output"))
FileUtils.mkdir_p(output_dir)
output_path = File.join(output_dir, result[:filename])
File.binwrite(output_path, result[:data])

warn "Saved: #{output_path}"
puts output_path
